---
import { skillGroups, secondarySkills } from '../data/portfolio';
---

<section id="skills" aria-labelledby="skills-heading" class="scroll-mt-24 space-y-10">
    <div class="space-y-3 text-center sm:text-left">
        <div class="inline-flex items-center gap-2 text-xs font-bold tracking-wider text-sky-600 uppercase dark:text-sky-400">
            <span class="h-2 w-2 rounded-full bg-sky-600 dark:bg-sky-400"></span>
            <span>Technical Capabilities</span>
        </div>
        <h2 id="skills-heading" class="font-display text-2xl font-bold text-slate-900 sm:text-3xl lg:text-4xl dark:text-white">Skills & Technologies</h2>
        <p class="max-w-3xl text-base text-slate-600 dark:text-slate-300">Organized by area with an emphasis on PHP, Laravel, relational databases, and modern web development.</p>
    </div>

    <!-- Primary Categories Grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
            skillGroups.map((group) => (
                <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
                    <div>
                        <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white">{group.category}</h3>
                        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{group.description}</p>

                        <div class="mt-4 flex flex-wrap gap-2">
                            {group.skills.map((skill) => (
                                <span class={`inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold transition-colors ${skill.highlight ? 'border border-sky-300 bg-sky-50 text-sky-800 dark:border-sky-700/60 dark:bg-sky-950/70 dark:text-sky-200' : 'border border-slate-200 bg-slate-50 text-slate-700 dark:border-slate-800 dark:bg-slate-800/80 dark:text-slate-300'}`}>
                                    {skill.highlight && <span class="mr-1.5 h-2 w-2 rounded-full bg-sky-500" aria-hidden="true" />}
                                    {skill.name}
                                </span>
                            ))}
                        </div>
                    </div>
                </div>
            ))
        }
    </div>

    <!-- Secondary / Additional Technologies Note -->
    <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-900/60">
        <h3 class="text-xs font-bold tracking-wider text-slate-700 uppercase dark:text-slate-300">Secondary & Exploratory Technologies</h3>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Technologies studied through coursework, self-study, or personal exploration alongside my core web development focus.</p>

        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3">
            {
                secondarySkills.map((tech) => (
                    <div class="rounded-lg border border-slate-200/80 bg-white p-3 dark:border-slate-800 dark:bg-slate-800/80">
                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">{tech.name}</span>
                        <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">{tech.note}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
