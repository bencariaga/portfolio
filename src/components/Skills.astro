---
import { skills } from '../data/portfolio';
---

<section id="tech-stack" class="space-y-8">
    <div class="space-y-2 text-center">
        <h2 class="font-display text-3xl font-bold text-slate-900 md:text-4xl dark:text-white">Tech Stack</h2>

        <p class="text-slate-700 dark:text-slate-300">
            Here are the tools that <strong class="text-green-500">I am currently learning</strong> and <strong class="text-blue-500">I want to learn</strong>.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
            skills.map((skillCat) => (
                <div class="border-border-light dark:border-border-dark dark:bg-card-dark rounded-2xl border bg-white p-6 shadow-sm">
                    <h3 class="border-border-light dark:border-border-dark mb-4 border-b pb-2 text-lg font-bold text-slate-900 dark:text-white">{skillCat.category}</h3>

                    <div class="flex flex-wrap gap-2">
                        {skillCat.skills.map((skill) => (
                            <a href={skill.url} target="_blank" rel="noopener noreferrer" class={`rounded-lg px-2.5 py-1.5 text-xs font-semibold transition-colors hover:opacity-80 ${skill.status === 'current' ? 'bg-green-200 text-green-800 dark:bg-green-800 dark:text-green-200' : 'bg-blue-200 text-blue-800 dark:bg-blue-800 dark:text-blue-100'}`}>
                                {skill.name}
                            </a>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</section>
