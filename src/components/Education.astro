---
import { education, credentials } from '../data/portfolio';
---

<section id="education" aria-labelledby="education-heading" class="scroll-mt-24 space-y-10">
    <div class="space-y-3 text-center sm:text-left">
        <div class="inline-flex items-center gap-2 text-xs font-bold tracking-wider text-sky-600 uppercase dark:text-sky-400">
            <span class="h-2 w-2 rounded-full bg-sky-600 dark:bg-sky-400"></span>
            <span>Academic Background & Continuous Learning</span>
        </div>
        <h2 id="education-heading" class="font-display text-2xl font-bold text-slate-900 sm:text-3xl lg:text-4xl dark:text-white">Education & Credentials</h2>
        <p class="max-w-3xl text-base text-slate-600 dark:text-slate-300">Degree coursework in Information Technology alongside government vocational certification and technical training.</p>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <!-- Formal Education Card (7 cols) -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:col-span-7 dark:border-slate-800 dark:bg-slate-900">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <span class="rounded-full bg-sky-100 px-3 py-1 text-xs font-semibold text-sky-800 dark:bg-sky-950/80 dark:text-sky-300"> Formal Education </span>
                    <span class="text-xs font-medium text-slate-500 dark:text-slate-400">{education.period}</span>
                </div>

                <div>
                    <h3 class="font-display text-xl font-bold text-slate-900 sm:text-2xl dark:text-white">
                        {education.degree}
                    </h3>
                    <p class="mt-1 text-sm font-semibold text-sky-700 dark:text-sky-400">
                        {education.institution}
                    </p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        {education.location} &middot; <span class="font-semibold text-emerald-600 dark:text-emerald-400">{education.status}</span>
                    </p>
                </div>

                <div class="pt-2">
                    <h4 class="text-xs font-bold tracking-wider text-slate-600 uppercase dark:text-slate-300">Program Highlights</h4>
                    <ul class="mt-2 space-y-2 text-xs text-slate-600 sm:text-sm dark:text-slate-300">
                        {
                            education.highlights?.map((highlight) => (
                                <li class="flex items-start gap-2.5">
                                    <i class="fa-solid fa-graduation-cap mt-1 text-sm text-sky-600 dark:text-sky-400" aria-hidden="true" />
                                    <span>{highlight}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Credentials & Training (5 cols) -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:col-span-5 dark:border-slate-800 dark:bg-slate-900">
            <div class="space-y-4">
                <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white">Credentials & Relevant Training</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Accredited vocational certification distinguished from academic seminars and symposiums.</p>

                <div class="space-y-4 pt-2">
                    {
                        credentials.map((cred) => (
                            <div class="border-l-2 border-sky-500 pl-3 dark:border-sky-400">
                                <div class="flex items-center justify-between">
                                    <span class={`inline-block rounded px-2 py-0.5 text-xs font-bold uppercase ${cred.type === 'Certification' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300'}`}>{cred.type}</span>
                                    <span class="text-xs text-slate-500 dark:text-slate-400">{cred.date}</span>
                                </div>
                                <h4 class="mt-1 text-sm font-bold text-slate-900 dark:text-white">{cred.title}</h4>
                                <p class="text-xs font-medium text-slate-600 dark:text-slate-400">{cred.issuer}</p>
                                {cred.description && <p class="mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">{cred.description}</p>}
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>
