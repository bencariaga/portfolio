---
import { socialLinks } from '../data/portfolio';
---

<section id="contact" aria-labelledby="contact-heading" class="scroll-mt-24 pb-12">
    <div class="rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm sm:p-12 dark:border-slate-800 dark:bg-slate-900">
        <div class="mx-auto max-w-2xl space-y-4">
            <div class="inline-flex items-center gap-2 text-xs font-bold tracking-wider text-sky-600 uppercase dark:text-sky-400">
                <span class="h-2 w-2 rounded-full bg-sky-600 dark:bg-sky-400"></span>
                <span>Get In Touch</span>
            </div>

            <h2 id="contact-heading" class="font-display text-2xl font-bold text-slate-900 sm:text-3xl dark:text-white">Let's Discuss Web Development Opportunities</h2>

            <p class="text-sm leading-relaxed text-slate-600 sm:text-base dark:text-slate-300">I am open to entry-level and junior full-stack web developer roles, project collaborations, and internships. Reach out directly via email or LinkedIn.</p>

            <!-- Direct Contact Methods -->
            <div class="mt-6 flex flex-col items-center justify-center gap-3 pt-2 sm:flex-row sm:gap-4">
                <a href="mailto:bencariaga13@gmail.com" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-sky-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-sky-700 focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:outline-none sm:w-auto">
                    <i class="fa-solid fa-envelope text-base" aria-hidden="true"></i>
                    <span>bencariaga13@gmail.com</span>
                </a>

                <a href="https://www.linkedin.com/in/benhur-cariaga/" target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-2xs transition-all hover:bg-slate-50 hover:text-sky-600 focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:outline-none sm:w-auto dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:hover:text-sky-400">
                    <i class="fa-brands fa-linkedin text-base text-sky-600 dark:text-sky-400" aria-hidden="true"></i>
                    <span>LinkedIn Profile</span>
                </a>
            </div>

            <!-- Social badges -->
            <div class="mt-6 flex items-center justify-center gap-5 pt-4 text-sm text-slate-500 dark:text-slate-400">
                {
                    socialLinks.map((social) => (
                        <a href={social.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 transition-colors hover:text-sky-600 dark:hover:text-sky-400" aria-label={`${social.name} (opens in a new tab)`}>
                            <i class={`${social.iconClass} text-lg`} aria-hidden="true" />
                            <span>{social.name}</span>
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</section>
