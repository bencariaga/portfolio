---
import { secondaryInterests } from '../data/portfolio';
---

<section id="interests" aria-labelledby="interests-heading" class="scroll-mt-24 space-y-8">
    <div class="space-y-2 text-center sm:text-left">
        <div class="inline-flex items-center gap-2 text-xs font-bold tracking-wider text-slate-500 uppercase dark:text-slate-400">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
            <span>Broader Intellectual Pursuits</span>
        </div>
        <h2 id="interests-heading" class="font-display text-2xl font-bold text-slate-900 sm:text-3xl dark:text-white">Secondary Interests & Creative Pursuits</h2>
        <p class="max-w-3xl text-sm text-slate-600 dark:text-slate-300">Complementary creative disciplines and computing areas I explore beyond primary full-stack web engineering.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
            secondaryInterests.map((interest) => (
                <div class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 shadow-2xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900">
                    <div class="space-y-2">
                        <span class="inline-block rounded bg-slate-100 px-2 py-0.5 text-[10px] font-bold tracking-wider text-slate-600 uppercase dark:bg-slate-800 dark:text-slate-300">{interest.subtitle}</span>
                        <h3 class="font-display text-base font-bold text-slate-900 dark:text-white">{interest.title}</h3>
                        <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">{interest.description}</p>
                    </div>
                </div>
            ))
        }
    </div>
</section>
