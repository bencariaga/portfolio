---
import { Image } from 'astro:assets';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
---

<section id="about" aria-labelledby="hero-heading" class="pt-6 pb-12 sm:pt-10 sm:pb-16">
    <div class="mx-auto flex flex-col items-center gap-8 md:flex-row md:items-center md:justify-between md:gap-12">
        <!-- Text introduction -->
        <div class="order-2 flex-1 text-center md:order-1 md:text-left">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 rounded-full border border-sky-200 bg-sky-50 px-3.5 py-1 text-xs font-semibold text-sky-800 dark:border-sky-800/60 dark:bg-sky-950/60 dark:text-sky-300">
                <span class="h-2 w-2 rounded-full bg-sky-500"></span>
                <span>Junior Full-Stack Web Developer</span>
            </div>

            <h1 id="hero-heading" class="font-display mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">Benhur L. Cariaga</h1>

            <p class="mt-2 text-lg font-semibold text-sky-700 sm:text-xl dark:text-sky-400">PHP &middot; Laravel &middot; TALL Stack (Tailwind, Alpine.js, Laravel, Livewire)</p>

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-300">I build database-driven web applications that help teams manage records and automate administrative tasks. My project work focuses on Laravel applications, relational databases, clean CRUD interfaces, role-based authentication, and one-time password (OTP) verification.</p>

            <div class="mt-3 flex items-center justify-center gap-2 text-sm text-slate-600 md:justify-start dark:text-slate-400">
                <i class="fa-solid fa-location-dot text-base text-sky-600 dark:text-sky-400" aria-hidden="true"></i>
                <span>Based in General Santos City, Philippines</span>
            </div>

            <!-- Call to Actions -->
            <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4 md:justify-start">
                <a href="#projects" class="inline-flex items-center justify-center gap-2 rounded-lg bg-sky-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-sky-700 hover:shadow-md focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 focus-visible:outline-none">
                    <span>Explore Featured Projects</span>
                    <i class="fa-solid fa-arrow-down text-sm" aria-hidden="true"></i>
                </a>

                <a href="#contact" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm transition-all hover:bg-slate-50 hover:text-sky-600 focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 focus-visible:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:hover:text-sky-400">
                    <i class="fa-solid fa-envelope text-sm" aria-hidden="true"></i>
                    <span>Contact Me</span>
                </a>

                <a href="https://github.com/bencariaga" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition-all hover:bg-slate-50 hover:text-sky-600 focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 focus-visible:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:hover:text-sky-400" aria-label="View Benhur Cariaga on GitHub (opens in a new tab)">
                    <i class="fa-brands fa-github text-lg" aria-hidden="true"></i>
                    <span>GitHub</span>
                </a>
            </div>
        </div>

        <!-- Authentic Profile Photo (increased size by ~12-15%) -->
        <div class="order-1 flex flex-col items-center md:order-2">
            <div class="relative h-50 w-50 overflow-hidden rounded-full border-4 border-white shadow-xl ring-4 ring-sky-500/30 sm:h-58 sm:w-58 dark:border-slate-800 dark:ring-sky-400/30">
                <Image src={`${baseUrl}/images/benhur-cariaga.png`} width={240} height={240} class="h-full w-full object-cover" alt="Portrait of Benhur L. Cariaga" loading="eager" />
            </div>
            <span class="mt-3 text-xs font-semibold tracking-wide text-slate-500 dark:text-slate-400">BSIT Candidate &middot; HTCGSC</span>
        </div>
    </div>
</section>
