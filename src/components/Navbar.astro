---
import { navLinks, socialLinks } from '../data/portfolio';
---

<!-- Top banner message -->
<div class="bg-blue-600 px-4 py-2 text-center text-sm font-semibold tracking-wide text-white">✨ Welcome, ladies and gentlemen! I am open to new opportunities and collaborations!</div>

<!-- Navigation Header -->
<header class="bg-wash/80 dark:bg-wash-dark/80 border-border-light dark:border-border-dark sticky top-0 z-50 border-b backdrop-blur-md transition-colors">
    <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3">
            <a href="/" class="group flex items-center gap-2">
                <span class="font-display text-[20px] font-extrabold tracking-wider text-black sm:mx-auto sm:text-[22px] md:text-[20px] lg:text-[18px] dark:text-white">BENHUR <span class="text-yellow-600 dark:text-yellow-400">CARIAGA</span></span>
            </a>
        </div>

        <!-- Nav Links -->
        <ul class="hidden items-center gap-6 text-sm font-medium lg:flex">
            {
                navLinks.map((link) => (
                    <li>
                        <a href={link.href} class="hover:text-brand dark:hover:text-brand-dark text-slate-600 transition-colors dark:text-slate-300">
                            {link.name}
                        </a>
                    </li>
                ))
            }
        </ul>

        <div class="flex gap-4">
            {
                socialLinks.map((social) => (
                    <a href={social.href} target="_blank" rel="noopener" class="hover:text-brand dark:hover:text-brand-dark text-2xl text-slate-500 transition-colors dark:text-slate-400" aria-label={social.name}>
                        <i class={social.iconClass} />
                    </a>
                ))
            }
        </div>
    </nav>
</header>
