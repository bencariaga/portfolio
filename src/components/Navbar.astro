---
import { navLinks } from '../data/portfolio';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
---

<!-- Announcement banner -->
<aside aria-label="Availability Status" class="bg-sky-700 px-4 py-2 text-center text-xs font-medium tracking-wide text-white sm:text-sm">
    <div class="mx-auto flex max-w-7xl items-center justify-center gap-2">
        <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-emerald-400" aria-hidden="true"></span>
        <span class="whitespace-nowrap">Open to entry-level and junior full-stack web developer opportunities.</span>
    </div>
</aside>

<!-- Navigation Header -->
<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-md transition-colors dark:border-slate-800 dark:bg-slate-900/90">
    <nav aria-label="Main Navigation" class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <!-- Logo / Wordmark -->
        <a href={`${baseUrl}/#about`} class="group mx-auto flex items-center gap-2 focus:outline-none md:mx-0">
            <span class="font-display text-lg font-bold tracking-tight text-slate-900 transition-colors group-hover:text-sky-600 dark:text-white dark:group-hover:text-sky-400">
                BENHUR <span class="text-sky-600 dark:text-sky-400">CARIAGA</span>
            </span>
        </a>

        <!-- Desktop Nav Links -->
        <ul class="hidden items-center gap-1 text-sm font-medium md:flex">
            {
                navLinks.map((link) => (
                    <li>
                        <a href={link.href} class="rounded-md px-3 py-2 text-slate-700 transition-colors hover:bg-slate-100 hover:text-sky-600 focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:outline-none dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-sky-400">
                            {link.name}
                        </a>
                    </li>
                ))
            }
        </ul>

        <!-- Right Controls: Theme Toggle & Mobile Menu Button -->
        <div class="hidden items-center gap-2 sm:gap-3 md:flex">
            <!-- Theme Toggle Button -->
            <button type="button" id="theme-toggle" class="invisible flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition-all hover:bg-slate-50 hover:text-sky-600 focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-sky-400" aria-label="Switch between light and dark theme" title="Toggle theme">
                <!-- Sun Icon (shown in dark mode) -->
                <i class="fa-solid fa-sun hidden text-lg text-amber-400 dark:block" aria-hidden="true"></i>
                <!-- Moon Icon (shown in light mode) -->
                <i class="fa-solid fa-moon block text-lg text-slate-600 dark:hidden" aria-hidden="true"></i>
                <span class="sr-only">Toggle theme</span>
            </button>

            <!-- Mobile Menu Toggle Button -->
            <button type="button" id="mobile-menu-btn" class="invisible flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-100 focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:outline-none md:hidden dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open mobile navigation menu">
                <i id="menu-icon-open" class="fa-solid fa-bars text-xl" aria-hidden="true"></i>
                <i id="menu-icon-close" class="fa-solid fa-xmark hidden text-xl" aria-hidden="true"></i>
            </button>
        </div>
    </nav>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-nav" class="hidden border-b border-slate-200 bg-white px-4 pt-2 pb-6 md:hidden dark:border-slate-800 dark:bg-slate-900" aria-label="Mobile Navigation">
        <ul class="flex flex-col space-y-1">
            {
                navLinks.map((link) => (
                    <li>
                        <a href={link.href} class="mobile-nav-link block rounded-lg px-3 py-2.5 text-base font-medium text-slate-700 transition-colors hover:bg-slate-100 hover:text-sky-600 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-sky-400">
                            {link.name}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</header>

<script>
    // Theme toggle functionality with safe storage access and system preference fallback
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
        themeBtn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.contains('dark');
            try {
                if (isDark) {
                    document.documentElement.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                } else {
                    document.documentElement.classList.add('dark');
                    localStorage.setItem('theme', 'dark');
                }
            } catch (e) {
                // If localStorage is unavailable or blocked, toggle class safely
                document.documentElement.classList.toggle('dark');
            }
        });
    }

    // Accessible Mobile Menu Drawer
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileNav = document.getElementById('mobile-nav');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    if (mobileBtn && mobileNav && openIcon && closeIcon) {
        const toggleMenu = (open?: boolean) => {
            const shouldOpen = open !== undefined ? open : mobileNav.classList.contains('hidden');

            if (shouldOpen) {
                mobileNav.classList.remove('hidden');
                openIcon.classList.add('hidden');
                closeIcon.classList.remove('hidden');
                mobileBtn.setAttribute('aria-expanded', 'true');
                mobileBtn.setAttribute('aria-label', 'Close mobile navigation menu');
            } else {
                mobileNav.classList.add('hidden');
                openIcon.classList.remove('hidden');
                closeIcon.classList.add('hidden');
                mobileBtn.setAttribute('aria-expanded', 'false');
                mobileBtn.setAttribute('aria-label', 'Open mobile navigation menu');
            }
        };

        mobileBtn.addEventListener('click', () => toggleMenu());

        // Close menu when clicking any mobile anchor link
        mobileLinks.forEach((link) => {
            link.addEventListener('click', () => toggleMenu(false));
        });

        // Close menu on Escape key press
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !mobileNav.classList.contains('hidden')) {
                toggleMenu(false);
                mobileBtn.focus();
            }
        });
    }
</script>
