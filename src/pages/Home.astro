---
import Contact from '../components/Contact.astro';
import Education from '../components/Education.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Interests from '../components/Interests.astro';
import Navbar from '../components/Navbar.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
---

<div class="bg-wash dark:bg-wash-dark font-text min-h-screen text-slate-800 transition-colors duration-300 dark:text-slate-200">
    <Navbar />

    <main class="mx-auto max-w-7xl space-y-32 p-4 sm:px-6 lg:px-8">
        <Hero />
        <Interests />
        <Projects />
        <Skills />
        <Education />
        <Contact />
    </main>

    <Footer />
</div>
